# =============================================================================
# .env.example - 비밀 설정 견본   (test 3.3)
# 이 파일을 복사해서 .env 를 만들고 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 들어 있어서 git(GitHub)에 올라가지 않습니다.
# =============================================================================

# 켤 선택 서비스: ai = Ollama 컨테이너(AI 코멘트), tunnel = Cloudflare Tunnel. 쉼표로 구분
# 메모리가 작은 서버(예: M2, Docker 2GB)에서는 비워 두기 → AI 대신 정해진 틀 문장
COMPOSE_PROFILES=ai

# DB 비밀번호. 길고 무작위로! 만드는 법: openssl rand -hex 24
POSTGRES_PASSWORD=

# Cloudflare Tunnel 토큰 (인터넷 공개할 때만 필요). README 의 "인터넷에 공개하기" 참고
TUNNEL_TOKEN=

# (선택) Mac에 Ollama를 직접 설치해 GPU로 빠르게 돌릴 때만 주석 해제
# OLLAMA_HOST=http://host.docker.internal:11434

# (선택) 다른 주소에서 API를 부를 때만. 쉼표로 구분
# CORS_ORIGINS=

# (선택) 포트 바꾸기. 기본값: 화면 127.0.0.1:5500, API 문서 127.0.0.1:8001
#   시놀로지 NAS 역방향 프록시 → 이 Mac 으로 연결할 때 예시 (M2 서버):
# FRONTEND_BIND=0.0.0.0
# FRONTEND_PORT=8003
# BACKEND_PORT=18003
