# =============================================================================
# .env.example - 비밀 설정 견본   (test 3.3, test 3.4 보안 항목 추가)
# 이 파일을 복사해서 .env 를 만들고 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 들어 있어서 git(GitHub)에 올라가지 않습니다.
# ⚠️ 실제 서버 주소·IP·비밀값은 .env 에만 적고, README 같은 공개 파일에는 절대 적지 마세요.
# =============================================================================

# 켤 선택 서비스: ai = Ollama 컨테이너(AI 코멘트), tunnel = Cloudflare Tunnel. 쉼표로 구분
# 메모리가 작은 서버(Docker 2GB 등)에서는 비워 두기 → AI 대신 정해진 틀 문장
# 입구는 하나만: NAS 역방향 프록시를 쓰면 tunnel 은 넣지 마세요 (입구가 적을수록 안전)
COMPOSE_PROFILES=ai

# DB 비밀번호. 길고 무작위로! 만드는 법: openssl rand -hex 24
POSTGRES_PASSWORD=

# [test 3.4] NAS 역방향 프록시 비밀 머리글 값. 만드는 법: openssl rand -hex 24
#   NAS 역방향 프록시의 "사용자 지정 머리글"에 X-Menu-Proxy: (이 값) 을 똑같이 넣어야 바깥에서 들어올 수 있어요.
#   비워 두면 검사하지 않아요 (개발 PC 용). 인터넷에 공개하는 서버에서는 꼭 채우세요.
PROXY_SECRET=

# Cloudflare Tunnel 토큰 (터널 방식으로 공개할 때만 필요). README 의 "인터넷에 공개하기" 참고
TUNNEL_TOKEN=

# (선택) Mac에 Ollama를 직접 설치해 GPU로 빠르게 돌릴 때만 주석 해제
# OLLAMA_HOST=http://host.docker.internal:11434

# (선택) 다른 주소에서 API를 부를 때만. 쉼표로 구분
# CORS_ORIGINS=

# (선택) 포트 바꾸기. 기본값: 화면 127.0.0.1:5500, 확인용 127.0.0.1:5501, API 문서 127.0.0.1:8001
#   NAS 역방향 프록시 → 이 Mac 으로 연결할 때 예시:
# FRONTEND_BIND=0.0.0.0
# FRONTEND_PORT=8003
# LOCAL_PORT=5501
# BACKEND_PORT=18003
