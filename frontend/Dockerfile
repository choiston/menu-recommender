# =============================================================================
# frontend/Dockerfile - 프론트엔드 컨테이너 이미지를 만드는 "레시피"
# HTML/CSS/JS 는 브라우저가 실행하므로, 서버는 파일을 그대로 전달만 하면 됩니다.
# 그래서 파이썬에 기본으로 들어 있는 간단한 웹 서버를 사용합니다.
# =============================================================================

# 파이썬 3.11 이 설치된 가벼운 리눅스 이미지에서 시작
FROM python:3.11-slim

# 컨테이너 안의 작업 폴더를 /app 으로 지정
WORKDIR /app
# 현재 폴더(frontend/)의 모든 파일(index.html, style.css, app.js ...)을 /app 으로 복사
COPY . .

# 5500번 포트를 사용한다는 표시 (실제 연결은 docker-compose.yml 의 ports)
EXPOSE 5500

# python -m http.server 5500
#   → 현재 폴더(/app)의 파일을 5500번 포트로 제공하는 파이썬 내장 웹 서버.
#     http://localhost:5500 에 접속하면 index.html 을 자동으로 보여 줍니다.
#   (공부/개발용으로 충분. 실제 서비스에서는 보통 nginx 같은 전문 웹 서버를 씁니다)
CMD ["python", "-m", "http.server", "5500"]
